# Copy to /etc/smmpanel.env on the VPS (chmod 600) and fill in real values.
DATABASE_URL=postgresql://smmpanel:CHANGE_ME@127.0.0.1:5432/smmpanel
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
PORT=3000
PROVIDER_API_KEY=
PROVIDER_API_URL=https://your-provider-panel.com/api/v2
PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production
