{
  "manifest_version": 3,
  "name": "OrganicSMM Pro",
  "short_name": "OrganicSMM",
  "version": "1.0.0",
  "description": "OrganicSMM Pro — organic social media growth platform. Place orders, manage wallet, track engagement and get instant notifications, right from your browser.",
  "author": "OrganicSMM Pro",
  "action": {
    "default_title": "OrganicSMM Pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "notifications",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://organicsmm.pro/*",
    "https://www.organicsmm.pro/*",
    "https://whopautopailot.site/*",
    "https://whopxbot.lovable.app/*",
    "https://lvrbhgulxqdsamhdjzkw.supabase.co/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Open OrganicSMM Pro popup"
    }
  },
  "minimum_chrome_version": "114"
}
